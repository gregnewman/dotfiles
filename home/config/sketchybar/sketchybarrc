PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=bottom height=40 blur_radius=30 color=0x40000000

##### Changing Defaults #####
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:15.0"
  label.font="Hack Nerd Font:Bold:12.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### AeroSpace Workspace Indicators #####
sketchybar --add event aerospace_workspace_change

WORKSPACE_IDS=(1 2 3 4 5 6 7 8 9 O)
WORKSPACE_ICONS=(
  ":reeder5:"      # 1: Reeder/Ivory
  ":toggl_track:"  # 2: Toggl/Tower
  ":emacs:"        # 3: Emacs/cmux
  ":safari:"       # 4: Safari
  ":drafts:"       # 5: Drafts/Obsidian
  ":calendar:"     # 6: Fantastical/OmniFocus/Things
  ":mail:"         # 7: MailMate
  ":slack:"        # 8: Messages/Slack
  ":vivaldi:"      # 9: Vivaldi
  ":orbstack:"     # O: OrbStack/Linear
)

for i in "${!WORKSPACE_IDS[@]}"; do
  ws="${WORKSPACE_IDS[$i]}"
  icon="${WORKSPACE_ICONS[$i]}"
  sketchybar --add item "ws.$ws" left \
             --set "ws.$ws" \
               icon="$icon" \
               icon.font="sketchybar-app-font:Regular:16.0" \
               icon.padding_left=7 \
               icon.padding_right=7 \
               background.color=0x40ffffff \
               background.corner_radius=5 \
               background.height=25 \
               background.drawing=off \
               label.drawing=off \
               script="$PLUGIN_DIR/aerospace_workspace.sh" \
               click_script="/opt/homebrew/bin/aerospace workspace $ws && /opt/homebrew/bin/aerospace focus --dfs-index 1 2>/dev/null; true" \
             --subscribe "ws.$ws" aerospace_workspace_change
done

##### Left Items #####
sketchybar --add item chevron left \
           --set chevron icon= label.drawing=off \
           --add item front_app left \
           --set front_app icon.font="sketchybar-app-font:Regular:16.0" \
                           icon.drawing=on \
                           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Right Items #####
sketchybar --add item clock right \
           --set clock update_freq=10 icon= script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add graph cpu right 75 \
           --set cpu update_freq=5 \
                     graph.color=0xffff6000 \
                     graph.fill_color=0x4fff6000 \
                     icon= \
                     y_offset=12 \
                     label.y_offset=-12 \
                     label.padding_left=10 \
                     script="$PLUGIN_DIR/cpu.sh"

FOCUSED=$(/opt/homebrew/bin/aerospace list-workspaces --focused 2>/dev/null)
sketchybar --trigger aerospace_workspace_change FOCUSED="$FOCUSED"

sketchybar --update
